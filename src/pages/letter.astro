---
import Site from '../layouts/Site.astro';
// Copy is Dylan's own. Leave it.
// The archive under the form lists the old issues, newest first. A new issue
// goes at the top. It stays on screen after a signup; only the form is swapped.
// The form posts to /api/subscribe, which adds the address to Beehiiv.
const issues = [
  { no: 4, title: 'If not now, when?', year: 2020, href: 'https://letter.dylandibona.com/p/if-not-now-when' },
  { no: 3, title: 'Do you go with Fall or Autumn?', year: 2017, href: 'https://letter.dylandibona.com/p/fall-or-autumn' },
  { no: 2, title: 'Busy is good, right?', year: 2016, href: 'https://letter.dylandibona.com/p/busy-is-good-right' },
  { no: 1, title: 'Some quick news', year: 2016, href: 'https://letter.dylandibona.com/p/some-quick-news' },
];
---
<Site title="The Letter — Dylan James DiBona" description="Notes sent from my point of view only every so often." crumbs={[{ label: "The Letter" }]} open read>
  <div class="eyebrow">The Letter</div>
  <p class="lede">Notes sent from my point of view only every so often.</p>

  <form class="signup" id="signup" novalidate>
    <label class="sr-only" for="email" style="position:absolute;left:-9999px">Email address</label>
    <input id="email" type="email" name="email" placeholder="Email address" required autocomplete="email" />
    <button type="submit">Subscribe</button>
  </form>
  <div class="said" id="said" role="status" aria-live="polite"></div>

  <section class="archive" aria-labelledby="previously">
    <h2 class="eyebrow" id="previously">Previously</h2>
    <ol>
      {issues.map((i) => (
        <li><a href={i.href} target="_blank" rel="noopener">No. {i.no} · {i.title} · {i.year}</a></li>
      ))}
    </ol>
  </section>
</Site>

<script>
  function wireSignup() {
    const form = document.getElementById('signup') as HTMLFormElement | null;
    const said = document.getElementById('said');
    if (!form || !said) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[name=email]') as HTMLInputElement;
      const button = form.querySelector('button') as HTMLButtonElement;
      said.textContent = ''; said.classList.remove('err');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())) {
        said.classList.add('err');
        said.textContent = 'That doesn\u2019t look like an email address.';
        input.focus();
        return;
      }
      button.disabled = true;
      try {
        const r = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: input.value }),
        });
        const { ok } = await r.json().catch(() => ({ ok: false }));
        if (ok) { form.classList.add('done'); said.classList.add('done'); said.textContent = 'You\u2019re on the list.'; }
        else fail();
      } catch {
        fail();
      } finally { button.disabled = false; }
    });
    function fail() {
      said.classList.add('err');
      said.textContent = 'That didn\u2019t take. Try again, or write to dylan@dylandibona.com.';
    }
  }
  wireSignup();
  document.addEventListener('astro:page-load', wireSignup);
</script>
