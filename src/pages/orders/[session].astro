---
export const prerender = false;

import { Image } from 'astro:assets';
import Site from '../../layouts/Site.astro';
import { findPrint } from '../../lib/prints';
import { SIZES, FRAMES, money } from '../../lib/pricing';
import { stripe } from '../../lib/stripe';

/**
 * The receipt. Stripe is the system of record: this page reads the session
 * back by id and shows what was bought and where it is going. A real URL, so
 * the confirmation email can be one link, and later the dispatch email too.
 * An unknown or unpaid session goes back to the prints.
 */
const id = Astro.params.session ?? '';
let s: any = null;
try {
  if (/^cs_/.test(id)) s = await stripe().checkout.sessions.retrieve(id);
} catch {}
if (!s || s.payment_status !== 'paid') return Astro.redirect('/prints', 302);

const print = findPrint(s.metadata?.slug ?? '');
const size  = SIZES.find((x) => x.code === s.metadata?.size);
const frame = FRAMES.find((x) => x.code === s.metadata?.frame);
const ship  = s.shipping_details ?? s.collected_information?.shipping_details ?? null;
const addr  = ship?.address;
const name  = ship?.name ?? s.customer_details?.name ?? '';
const email = s.customer_details?.email ?? '';
const amount = money(s.amount_total ?? 0);
---
<Site title="Order received — Dylan James DiBona" description="Order received."
      crumbs={[{ label: 'Prints', href: '/prints' }, { label: 'Order' }]} open>
  {/* Same shape as the print page: the framed print left, the facts right. */}
  <div class="detail receipt">
    <div class="shot">
      {print && (
        <div class="mount" data-frame={frame?.code ?? 'black'}>
          <span class="rail rail-t"></span><span class="rail rail-r"></span>
          <span class="rail rail-b"></span><span class="rail rail-l"></span>
          <Image src={print.image} alt={print.title} widths={[900, 1400]}
                 sizes="(max-width:920px) 88vw, 55vw" quality={82} />
        </div>
      )}
    </div>

    <div class="buy">
      <div class="eyebrow">Your order</div>
      <h2>{print?.title ?? 'Your print'}</h2>
      {print?.where && <div class="label" style="margin:-.4em 0 1.4em">{print.where}</div>}

      <div class="rx">
        {size && <span>{size.cm} cm · {size.inches} in</span>}
        {frame && <span>{frame.code === 'none' ? 'Unframed, ships rolled' : `Framed in ${frame.label.toLowerCase()}`}</span>}
        <span>{amount}</span>
      </div>

      {addr && (
        <>
          <div class="label" style="margin-top:2em">Shipping to</div>
          <div class="rx">
            <span>{name}</span>
            <span>{addr.line1}</span>
            {addr.line2 && <span>{addr.line2}</span>}
            <span>{addr.city}{addr.state ? `, ${addr.state}` : ''} {addr.postal_code}</span>
            <span>{addr.country}</span>
          </div>
        </>
      )}

      <div class="fine" style="margin-top:2.2em">
        Made to order by hand in London. Allow up to 10 days depending on your address. A note goes to {email} when it ships.
      </div>
      <div class="fine">Order {s.id.slice(-8).toUpperCase()}</div>
    </div>
  </div>
</Site>
