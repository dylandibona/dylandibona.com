---
/**
 * The new-window mark, for any link that leaves the site. An SVG rather than
 * the ↗ character, which iOS draws as an emoji. Sized and spaced by .ext.
 */
---
<svg class="ext" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 7.5 7.5 2.5M3.5 2.5h4v4"/></svg>
